{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theuapindex/schema/record.json",
  "title": "UAP Record",
  "description": "Schema for a released UAP or UFO document record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uuid",
    "description",
    "file_name",
    "release_date",
    "release_version",
    "agency",
    "incident_date",
    "incident_location",
    "official_url"
  ],
  "properties": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "file_name": {
      "type": "string",
      "minLength": 1
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "release_version": {
      "type": "string",
      "minLength": 1
    },
    "agency": {
      "type": "string",
      "minLength": 1
    },
    "incident_date": {
      "type": "string",
      "minLength": 1
    },
    "incident_location": {
      "type": "string",
      "minLength": 1
    },
    "official_url": {
      "type": "string",
      "format": "uri"
    }
  }
}
